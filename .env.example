# --- App ---
APP_NAME=ApiEMS
ENVIRONMENT=development        # development | production | testing
LOG_LEVEL=INFO

# --- InfluxDB 2.x ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=changeme
INFLUX_ORG=myorg
INFLUX_BUCKET=modbus_data_v2

# --- MQTT (Mosquitto) ---
MQTT_HOST=192.168.1.26
MQTT_PORT=1883
MQTT_USER=gatewayems
MQTT_PASSWORD=changeme
MQTT_TOPIC=gatewayems/modbus
MQTT_QOS=1
# Distinto al client_id del script de adquisición (IDs duplicados = desconexiones)
MQTT_CLIENT_ID=apiems-backend

# --- JWT ---
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE=30                  # access token, minutos
JWT_REFRESH_EXPIRE=10080       # refresh token, minutos (7 días)

# --- API auth (usuario único) ---
API_USERNAME=admin
API_PASSWORD=changeme

# --- CORS (separado por comas) ---
CORS_ORIGINS=http://localhost:4321,https://USER.github.io

# --- Zona horaria (límites de día/semana/mes/año; la API sigue exponiendo UTC) ---
TIMEZONE=America/Bogota

# --- CRMBackend (Fase 5, no conectado todavía — ver prompt_arquitectura_v2.md) ---
CRM_BASE_URL=http://localhost:8000
CRM_SERVICE_EMAIL=servicio@example.com
CRM_SERVICE_PASSWORD=changeme
