# --- App ---
APP_NAME=ApiEMS
ENVIRONMENT=development        # development | production | testing
# Puerto en el que escucha. Con network_mode: host el contenedor toma este
# puerto del host directamente: si otro servicio ya lo tiene, uvicorn no
# arranca y el contenedor queda reiniciándose.
API_PORT=8000
LOG_LEVEL=INFO

# --- InfluxDB 2.x ---
# Con esquema (http:// o https://). Sin él el cliente arranca igual y falla
# recién en la primera consulta, que es el peor momento para enterarse.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=changeme
INFLUX_ORG=myorg
INFLUX_BUCKET=modbus_data_v2

# --- MQTT (Mosquitto) ---
# Nombre de host, no IP: el certificado se emite para un nombre y la
# verificación falla si te conectás al número.
MQTT_HOST=mqtt.example.sslip.io
# 8883 con TLS. El 1883 manda usuario y contraseña en claro por la red.
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USER=gatewayems
MQTT_PASSWORD=changeme
MQTT_TOPIC=gatewayems/modbus
MQTT_QOS=1
# Distinto al client_id del script de adquisición (IDs duplicados = desconexiones)
MQTT_CLIENT_ID=apiems-backend

# --- CORS (separado por comas) ---
CORS_ORIGINS=http://localhost:4321,https://USER.github.io

# --- Zona horaria (límites de día/semana/mes/año; la API sigue exponiendo UTC) ---
TIMEZONE=America/Bogota

# --- Variables del panel ---
# Cuántas horas hacia atrás se mira para marcar qué variables tienen datos
# (fieldKeys recorre datos, así que esta ventana domina la primera carga).
# 1h para probar, 24h (default) para producción.
VARIABLES_LOOKBACK_HOURS=24

# --- CRMBackend: identidad y tarifas ---
# ApiEMS no autentica a nadie: verifica el token que firma el CRM, con la clave
# pública que publica en /.well-known/jwks.json. Sin secreto compartido, así
# que este servicio nunca puede falsificar uno.
#
# La credencial de servicio se emite en el CRM: Servicios > Nueva credencial.
# Es de solo lectura y necesita los permisos `tariffs:read` y `fleet:read`.
CRM_BASE_URL=http://localhost:8000
# Credencial de servicio emitida en CRMBackend (POST /api/v1/service-accounts, solo admin)
CRM_CLIENT_ID=changeme
CRM_CLIENT_SECRET=changeme

# Solo la audiencia `monitor`, la de la web de clientes: un token de operador
# del CRM es válido y aun así no abre el consumo de nadie.
CRM_JWT_AUDIENCE=monitor
# Las claves cambian solo al rotarlas; releerlas por request es puro gasto.
CRM_JWKS_CACHE_SECONDS=3600
# Corto: un equipo nuevo en el CRM debe aparecer sin reiniciar nada.
CRM_FLEET_CACHE_SECONDS=300
